# --- Telegram ---
# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Режим связи с Telegram: polling (по умолчанию, для разработки) или webhook (прод)
BOT_MODE=polling

# Публичный домен для webhook (обязателен только при BOT_MODE=webhook)
# Пример: https://bot.example.com
BOT_WEBHOOK_DOMAIN=

# --- База данных ---
# Строка подключения PostgreSQL для Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/zazyvala?schema=public

# --- HTTP ---
# Порт HTTP-сервера (healthcheck, в будущем — webhook и админка)
PORT=3000

# --- Логи ---
# Уровень логирования: error | warn | log | debug | verbose
LOG_LEVEL=debug

# --- Админка ---
# Токен доступа к веб-админке (/admin). Если пусто — админка отключена.
ADMIN_TOKEN=

# --- Меню команд (кнопка "/") ---
# БЕЛЫЙ СПИСОК команд. Если задан — в /help и меню "/" показываются ТОЛЬКО эти
# команды, и только они выполняются (остальные игнорируются; /start и /help
# всегда доступны). Если пусто — доступны все встроенные команды.
# Формат: "команда:описание", разделитель ";" или перевод строки.
# Имя команды должно совпадать с реальной (call, join, leave, ... — НЕ "all").
# Пример:
# BOT_COMMANDS=call:Позвать всех;join:Подписаться;leave:Отписаться
BOT_COMMANDS=
