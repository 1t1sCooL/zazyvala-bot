# --- Telegram ---
# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Режим связи с Telegram: polling (по умолчанию, для разработки) или webhook (прод)
BOT_MODE=polling

# Публичный домен для webhook (обязателен только при BOT_MODE=webhook)
# Пример: https://bot.example.com
BOT_WEBHOOK_DOMAIN=

# --- База данных ---
# Строка подключения PostgreSQL для Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/zazyvala?schema=public

# --- HTTP ---
# Порт HTTP-сервера (healthcheck, в будущем — webhook и админка)
PORT=3000

# --- Логи ---
# Уровень логирования: error | warn | log | debug | verbose
LOG_LEVEL=debug

# --- Админка ---
# Токен доступа к веб-админке (/admin). Если пусто — админка отключена.
ADMIN_TOKEN=

# --- Меню команд (кнопка "/") ---
# Список команд для setMyCommands. Формат: пары "команда:описание",
# разделённые ";" (или переводом строки). Если пусто — встроенный список.
# Пример:
# BOT_COMMANDS=call:Позвать всех;join:Подписаться;leave:Отписаться;help:Справка
BOT_COMMANDS=call:Позвать всех
